function Counter() {
  const [count, setCount] = useState(0);

  return (
    <div>
      <h1>My Counter</h1>

      <p>You clicked the button {count} times.</p>

      <button onClick={() => setCount(count + 1)}>
        Click Me
      </button>
    </div>
  );
}

export default Counter;



