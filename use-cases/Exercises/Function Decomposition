## Decomposition

One function per concern, each returning its own error array; main function just concatenates results.

```javascript
const USERNAME_MIN = 3, USERNAME_MAX = 20, PASSWORD_MIN = 8;
const MIN_AGE = 13, MAX_AGE = 120;
const EMAIL_REGEX = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
const USERNAME_REGEX = /^[a-zA-Z0-9_]+$/;
const PHONE_REGEX = /^\+?[\d\s\-()]{10,15}$/;
const POSTAL_REGEX = { US: /^\d{5}(-\d{4})?$/, CA: /^[A-Za-z]\d[A-Za-z] \d[A-Za-z]\d$/, UK: /^[A-Z]{1,2}\d[A-Z\d]? \d[A-Z]{2}$/ };
const POSTAL_ERROR = { US: 'Invalid US ZIP code format', CA: 'Invalid Canadian postal code format', UK: 'Invalid UK postal code format' };

function validateRequiredRegistrationFields(userData) {
  const errors = [];
  for (const field of ['username', 'email', 'password', 'confirmPassword']) {
    if (!userData[field] || userData[field].trim() === '') errors.push(`${field} is required for registration`);
  }
  return errors;
}

function validateUsername(userData, options) {
  const { username } = userData;
  if (!username) return [];
  if (username.length < USERNAME_MIN) return [`Username must be at least ${USERNAME_MIN} characters long`];
  if (username.length > USERNAME_MAX) return [`Username must be at most ${USERNAME_MAX} characters long`];
  if (!USERNAME_REGEX.test(username)) return ['Username can only contain letters, numbers, and underscores'];
  if (options.checkExisting?.usernameExists(username)) return ['Username is already taken'];
  return [];
}

function validatePassword(userData) {
  const { password } = userData;
  const errors = [];
  if (password) {
    if (password.length < PASSWORD_MIN) errors.push(`Password must be at least ${PASSWORD_MIN} characters long`);
    else if (!/[A-Z]/.test(password)) errors.push('Password must contain at least one uppercase letter');
    else if (!/[a-z]/.test(password)) errors.push('Password must contain at least one lowercase letter');
    else if (!/[0-9]/.test(password)) errors.push('Password must contain at least one number');
    else if (!/[^A-Za-z0-9]/.test(password)) errors.push('Password must contain at least one special character');
  }
  if (userData.confirmPassword !== password) errors.push('Password and confirmation do not match');
  return errors;
}

function validateProfileRequiredFields(userData) {
  const errors = [];
  for (const field of ['firstName', 'lastName', 'dateOfBirth', 'address']) {
    if (userData[field] !== undefined && userData[field].trim() === '') errors.push(`${field} cannot be empty if provided`);
  }
  return errors;
}

function validateEmail(userData, options, isRegistration) {
  const { email } = userData;
  if (email === undefined) return [];
  if (email.trim() === '') return isRegistration ? ['Email is required'] : [];
  if (!EMAIL_REGEX.test(email)) return ['Email format is invalid'];
  if (options.checkExisting?.emailExists(email)) return ['Email is already registered'];
  return [];
}

function validateDateOfBirth(userData) {
  const { dateOfBirth } = userData;
  if (!dateOfBirth) return [];
  const dob = new Date(dateOfBirth);
  if (isNaN(dob.getTime())) return ['Date of birth is not a valid date'];
  const now = new Date();
  const minAgeDate = new Date(now.getFullYear() - MIN_AGE, now.getMonth(), now.getDate());
  const maxAgeDate = new Date(now.getFullYear() - MAX_AGE, now.getMonth(), now.getDate());
  if (dob > now) return ['Date of birth cannot be in the future'];
  if (dob > minAgeDate) return [`You must be at least ${MIN_AGE} years old`];
  if (dob < maxAgeDate) return [`Invalid date of birth (age > ${MAX_AGE} years)`];
  return [];
}

function validatePostalCode({ zip, country }) {
  const regex = POSTAL_REGEX[country];
  if (zip && regex && !regex.test(zip)) return [POSTAL_ERROR[country]];
  return [];
}

function validateAddress(userData) {
  const { address } = userData;
  if (!address) return [];
  if (typeof address !== 'object') return ['Address must be an object with required fields'];
  const errors = [];
  for (const field of ['street', 'city', 'zip', 'country']) {
    if (!address[field] || address[field].trim() === '') errors.push(`Address ${field} is required`);
  }
  return errors.concat(validatePostalCode(address));
}

function validatePhone(userData) {
  const { phone } = userData;
  if (!phone) return [];
  return PHONE_REGEX.test(phone) ? [] : ['Phone number format is invalid'];
}

function runCustomValidations(userData, options) {
  if (!options.customValidations) return [];
  const errors = [];
  for (const { field, validator, message } of options.customValidations) {
    if (userData[field] !== undefined && !validator(userData[field], userData)) {
      errors.push(message || `Invalid value for ${field}`);
    }
  }
  return errors;
}

function validateUserData(userData, options = {}) {
  const isRegistration = options.isRegistration || false;
  const roleErrors = isRegistration
    ? [...validateRequiredRegistrationFields(userData), ...validateUsername(userData, options), ...validatePassword(userData)]
    : validateProfileRequiredFields(userData);

  return [
    ...roleErrors,
    ...validateEmail(userData, options, isRegistration),
    ...validateDateOfBirth(userData),
    ...validateAddress(userData),
    ...validatePhone(userData),
    ...runCustomValidations(userData, options)
  ];
}
```

Each rule set is now independently testable, magic numbers are named constants, and the orchestrator reads as a table of contents.













